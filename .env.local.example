# 可选：覆盖默认 JSONL 路径（默认为 ~/cursor-events.jsonl 与 ~/thinking-corpus.jsonl）
# EVENTS_JSONL_PATH=/path/to/cursor-events.jsonl
# CORPUS_JSONL_PATH=/path/to/thinking-corpus.jsonl
# PROMPT_CORPUS_PATH=/path/to/prompt-corpus.jsonl

# 按日分片与保留（默认：按日写入、保留 90 天）
# JSONL_DAILY_SPLIT=0
# JSONL_RETENTION_DAYS=90
# MAX_JSONL_BYTES=52428800
# MAX_JSONL_TAIL_LINES=100000
