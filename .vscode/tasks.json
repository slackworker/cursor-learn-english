{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "新用户一键配置",
      "detail": "npm install + 安装 Hooks（WSL 下默认顺带装 Windows）。改 scripts/*.mjs 后请改用「更新 Cursor Hooks」。",
      "type": "shell",
      "command": "npm install && node scripts/setup-cursor-hooks.mjs --also-windows",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": [],
      "presentation": { "reveal": "always" }
    },
    {
      "label": "更新 Cursor Hooks（改脚本后必跑）",
      "detail": "同步 hooks 运行时脚本与 hooks.json 到 ~/.cursor/（WSL 下默认顺带更新 Windows）。",
      "type": "shell",
      "command": "node scripts/setup-cursor-hooks.mjs --also-windows",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": [],
      "presentation": { "reveal": "always" }
    },
    {
      "label": "仅更新本机 Hooks（不含 Windows）",
      "detail": "只安装当前环境的 ~/.cursor，不写 Windows 侧。",
      "type": "shell",
      "command": "node scripts/setup-cursor-hooks.mjs",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": [],
      "presentation": { "reveal": "always" }
    },
    {
      "label": "本地访问：启动 dev（仅本机）",
      "type": "shell",
      "command": "npm run dev",
      "options": { "cwd": "${workspaceFolder}" },
      "group": { "kind": "build", "isDefault": true },
      "isBackground": true,
      "problemMatcher": {
        "owner": "next",
        "pattern": { "regexp": "^$" },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".",
          "endsPattern": "Ready in|started server on|Local:.*http"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "focus": true
      }
    },
    {
      "label": "WSL/宿主机访问：启动 dev",
      "type": "shell",
      "command": "npm run dev:host",
      "options": { "cwd": "${workspaceFolder}" },
      "group": "build",
      "isBackground": true,
      "problemMatcher": {
        "owner": "next",
        "pattern": { "regexp": "^$" },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".",
          "endsPattern": "Ready in|started server on|Local:.*http"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "focus": true
      }
    }
  ]
}
